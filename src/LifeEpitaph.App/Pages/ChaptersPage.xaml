<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeEpitaph.App.Pages.ChaptersPage"
             Title="人生剧情"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="28,36" Spacing="16">
            <Label Text="人生剧情" Style="{StaticResource BrandTitle}" />
            <Label Text="打开故事可读可丰富；点「分享到广场」即可发出去"
                   Style="{StaticResource SoftSubtitle}" />
            <VerticalStackLayout x:Name="ChapterList" Spacing="14" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
