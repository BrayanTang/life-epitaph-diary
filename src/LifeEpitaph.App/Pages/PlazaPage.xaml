<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeEpitaph.App.Pages.PlazaPage"
             Title="墓碑广场"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="28,36" Spacing="16">
            <Label Text="墓碑广场" Style="{StaticResource BrandTitle}" />
            <Label Text="别人分享的日志与剧情 · 可献花 · 无评论"
                   Style="{StaticResource SoftSubtitle}" />

            <HorizontalStackLayout Spacing="12">
                <Button x:Name="AllTabButton"
                        Text="全部"
                        Style="{StaticResource QuietButton}"
                        Clicked="OnAllTabClicked" />
                <Button x:Name="MineTabButton"
                        Text="我的"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource AccentMoss}"
                        Clicked="OnMineTabClicked" />
            </HorizontalStackLayout>

            <Label x:Name="SectionHint"
                   Text=""
                   Style="{StaticResource SoftSubtitle}" />

            <VerticalStackLayout x:Name="PlazaList" Spacing="14" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
