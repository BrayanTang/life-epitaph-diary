<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeEpitaph.App.Pages.ProfilePage"
             Title="我的"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="28,36" Spacing="18">
            <Label Text="我的" Style="{StaticResource BrandTitle}" />
            <Label Text="私密日志默认只有你看见。选一条分享后，去广场「我的」看献花。"
                   Style="{StaticResource SoftSubtitle}" />

            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource StoneSurface}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="隐私" Style="{StaticResource SectionLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="允许出现在广场"
                               VerticalTextAlignment="Center"
                               TextColor="{StaticResource SoftInk}" />
                        <Switch x:Name="PublicSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource AccentMoss}"
                                Toggled="OnPublicToggled" />
                    </Grid>
                    <Label x:Name="PrivacyHintLabel"
                           Text="关闭后，新分享不会主动推到广场流。"
                           FontSize="12"
                           TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="自由日志" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            <Editor x:Name="JournalEditor"
                    Placeholder="地铁上的一句、晚饭的味道、没说出口的话…"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="120"
                    BackgroundColor="{StaticResource EditorSurface}"
                    TextColor="{StaticResource SoftInk}"
                    PlaceholderColor="{StaticResource MutedInk}" />
            <Button Text="写入日志"
                    Style="{StaticResource QuietButton}"
                    Clicked="OnSaveJournalClicked" />
            <Label x:Name="JournalHintLabel" FontSize="12" TextColor="{StaticResource MutedInk}" />
            <VerticalStackLayout x:Name="JournalList" Spacing="10" />

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,12" />
            <Label Text="账号" Style="{StaticResource SectionLabel}" />
            <Label x:Name="DeviceIdLabel" FontSize="13" TextColor="{StaticResource MutedInk}" />
            <Label x:Name="UserIdLabel" FontSize="13" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
